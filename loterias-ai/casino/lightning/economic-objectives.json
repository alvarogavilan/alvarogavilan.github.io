    {"id":"multiplier-window-4-10","windowsRounds":[4,5,6,7,8,9,10],"definition":"Comprobar si la probabilidad de observar un ganador Lightning en las siguientes 4-10 rondas cambia de forma reproducible según el tiempo transcurrido desde el último ganador Lightning.","metrics":["unconditional-window-rate","conditional-window-rate","conditional-vs-unconditional-ratio","sample-size","confidence-interval","permutation-or-null-calibration"],"promotionRule":"No usar como señal predictiva salvo mejora OOS/prospectiva y replicación independiente."},
    {"id":"lightning-x50","exactMultiplier":50,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x100","exactMultiplier":100,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x200","exactMultiplier":200,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x300","exactMultiplier":300,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x400","exactMultiplier":400,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x500","exactMultiplier":500,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown","repeatability"]},
