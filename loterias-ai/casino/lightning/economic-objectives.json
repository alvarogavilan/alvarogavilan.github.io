      "coverage4": {"stakePerNumber":3.75,"uniformHitProbability":0.10810810810810811,"normalHitNetPnlEUR":97.5,"breakEvenHitRateWithoutLightning":0.13333333333333333,"requiredRelativeLiftVsUniform":0.23333333333333334},
