{
  "schemaVersion": 2,
  "createdAt": "2026-08-17",
  "mode": "PAPER_ONLY",
  "purpose": "Medir coste realista por objetivo en Lightning sin confundir un acierto aislado con una estrategia rentable.",
  "officialStandardMultipliers": [50,100,200,300,400,500],
  "objectives": [
    {"id":"single-number-hit","coverage":[1],"metrics":["rounds-to-first-hit","euros-staked-to-first-hit","net-pnl-at-hit","max-drawdown"]},
    {"id":"small-set-hit","coverage":[2,3,4,5],"metrics":["hit-rate-vs-baseline","euros-staked-to-first-hit","net-pnl","max-drawdown"]},
    {"id":"lightning-x50","exactMultiplier":50,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x100","exactMultiplier":100,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x200","exactMultiplier":200,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x300","exactMultiplier":300,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x400","exactMultiplier":400,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown"]},
    {"id":"lightning-x500","exactMultiplier":500,"metrics":["rounds-to-first","euros-staked-to-first","net-pnl-at-first","max-drawdown","repeatability"]},
    {"id":"unexpected-multiplier","definition":"cualquier multiplicador real observado fuera de [50,100,200,300,400,500] se conserva para auditoría de variante/promoción/fuente"}
  ],
  "paperStakeScenariosEUR": {
    "singleNumber": [1,2,5,6,7,10],
    "smallSetTotal": [5,10,20,30],
    "rule": "Cada escenario se evalúa por separado; nunca se aumenta stake tras pérdidas para maquillar tiempo hasta objetivo."
  },
  "hardRiskGates": {
    "realMoneyEnabled": false,
    "martingaleOrLossChasing": false,
    "stakeEscalationAfterLoss": false,
    "claim99PercentSingleOrTinySetWithoutProspectiveEvidence": false,
    "minimumProspectivePaperRoundsBeforePromotion": 10000,
    "requirePositiveNetEVAfterCosts": true,
    "requireIndependentReplication": true,
    "requireMultiplicityCorrection": true
  },
  "reporting": [
    "total-rounds","total-staked-eur","gross-return-eur","net-pnl-eur","roi","max-drawdown-eur","longest-losing-run","first-hit-round","first-x50-round","first-x100-round","first-x200-round","first-x300-round","first-x400-round","first-x500-round","cost-to-first-x50-eur","cost-to-first-x100-eur","cost-to-first-x200-eur","cost-to-first-x300-eur","cost-to-first-x400-eur","cost-to-first-x500-eur","repeat-x500-count","unexpected-multiplier-count","confidence-vs-random-baseline"
  ]
}
