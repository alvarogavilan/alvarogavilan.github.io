{
  "schemaVersion": 2,
  "createdAt": "2026-08-17",
  "study": "Lightning Roulette Historical Replay",
  "mode": "PAPER_ONLY",
  "objective": "Reproducir cronológicamente cada ronda y medir cuándo una estrategia congelada habría acertado el ganador y, por separado, cuándo ese ganador habría recibido cada multiplicador Lightning oficial.",
  "predictionCoverageSizes": [1,2,3,4,5,6,8,10,12,15,18],
  "officialStandardMultipliers": [50,100,200,300,400,500],
  "unexpectedMultiplierPolicy": "retain-and-audit",
  "strictChronology": {
    "futureRowsVisible": false,
    "predictionMustExistBeforeOutcome": true,
    "retuningAfterOutcome": false,
    "rollingOriginEvaluation": true
  },
  "milestones": [
    {"id":"WINNER_HIT","definition":"el número ganador estaba en el conjunto predicho"},
    {"id":"LIGHTNING_WINNER_HIT","definition":"el ganador estaba predicho y fue además número Lightning"},
    {"id":"X50_EXACT","exactMultiplier":50},
    {"id":"X100_EXACT","exactMultiplier":100},
    {"id":"X200_EXACT","exactMultiplier":200},
    {"id":"X300_EXACT","exactMultiplier":300},
    {"id":"X400_EXACT","exactMultiplier":400},
    {"id":"X500_EXACT","exactMultiplier":500},
    {"id":"UNEXPECTED_MULTIPLIER","definition":"cualquier valor real observado fuera del registro oficial se conserva y se audita; no se descarta ni se transforma"}
  ],
  "requiredOutputsPerModel": [
    "roundsEvaluated",
    "coverageSize",
    "winnerHits",
    "winnerHitRate",
    "randomBaselineHitRate",
    "excessHitRate",
    "lightningWinnerHits",
    "x50ExactHits",
    "x100ExactHits",
    "x200ExactHits",
    "x300ExactHits",
    "x400ExactHits",
    "x500ExactHits",
    "unexpectedMultiplierHits",
    "roundsUntilFirstWinnerHit",
    "roundsUntilFirstX50",
    "roundsUntilFirstX100",
    "roundsUntilFirstX200",
    "roundsUntilFirstX300",
    "roundsUntilFirstX400",
    "roundsUntilFirstX500",
    "longestMissStreak",
    "multiplicityAdjustedEvidence",
    "paperNetEVIfRulesKnown"
  ],
  "antiIllusionRules": {
    "compareEachCoverageToItsOwnBaseline": true,
    "doNotCountHistoricalMultiplierAsPredictionUnlessPredeclared": true,
    "doNotCallX500PredictableFromOneOccurrence": true,
    "multipleTestingCorrectionRequired": true,
    "independentHoldoutRequired": true,
    "prospectivePaperRequired": true,
    "realMoneyEnabled": false
  }
}
