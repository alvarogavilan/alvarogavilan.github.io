{
  "version": "2026-08-14.2",
  "policy": {
    "noGuaranteedWins": true,
    "noFabricatedProbabilities": true,
    "preDrawSealRequired": true,
    "historicalBacktestRequired": true,
    "signalMustBeatBaseline": true
  },
  "cabinets": [
    {
      "id": "navidad-specialist",
      "gameId": "navidad",
      "name": "Gabinete Especialista Lotería de Navidad",
      "status": "DATA_PENDING",
      "minimumHistoricalDraws": 50,
      "models": [
        "digit-position-frequency",
        "terminal-frequency",
        "decade-distribution",
        "repetition-distance",
        "entropy-by-position",
        "historical-prize-distribution",
        "candidate-diversification",
        "prize-location-history",
        "administration-prize-history",
        "province-prize-history",
        "sales-volume-normalized-location-rate",
        "population-normalized-location-rate",
        "ticket-distribution-normalized-location-rate"
      ],
      "geographicPolicy": {
        "useRawPrizeCounts": false,
        "normalizersRequired": ["sales-volume","population","tickets-or-decimos-distributed-when-verifiable"],
        "rule": "A place with more historical prizes is not treated as more predictive unless the excess survives normalization and out-of-sample testing."
      },
      "outputs": [
        "candidate-numbers",
        "internal-model-score",
        "historical-sample-size",
        "backtest-roi",
        "baseline-roi",
        "excess-roi",
        "drawdown",
        "geographic-signal-score",
        "geographic-signal-confidence",
        "cost-simulation",
        "methodology-version"
      ],
      "rule": "No candidate number is released until the historical dataset passes integrity and minimum-sample gates. Internal scores are not represented as the true probability of a future number."
    },
    {
      "id": "nino-specialist",
      "gameId": "nino",
      "name": "Gabinete Especialista Sorteo de El Niño",
      "status": "DATA_PENDING",
      "minimumHistoricalDraws": 50,
      "models": [
        "digit-position-frequency",
        "terminal-frequency",
        "decade-distribution",
        "repetition-distance",
        "entropy-by-position",
        "historical-prize-distribution",
        "candidate-diversification",
        "prize-location-history",
        "sales-volume-normalized-location-rate"
      ],
      "outputs": [
        "candidate-numbers",
        "internal-model-score",
        "historical-sample-size",
        "backtest-roi",
        "baseline-roi",
        "excess-roi",
        "drawdown",
        "cost-simulation",
        "methodology-version"
      ],
      "rule": "El Niño is modeled independently from Christmas and ordinary Lotería Nacional; datasets and fitted parameters must never be pooled without an explicit validated experiment."
    }
  ]
}