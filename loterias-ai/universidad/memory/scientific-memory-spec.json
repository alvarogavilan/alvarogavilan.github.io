{
  "version":"1.1",
  "name":"Loterias AI Permanent Scientific Memory",
  "status":"ACTIVE_SPEC",
  "mission":"Registrar permanentemente fórmulas, hipótesis, experimentos, resultados, negativos, genealogías y comportamientos predictivos para impedir repetir trabajo y reutilizar toda evidencia científica.",
  "principles":["append-only-evidence","content-addressed-identities","semantic-deduplication","behavioral-deduplication","negative-results-first-class","full-genealogy","reproducible-runs","queryable-indexes","oos-immutability","no-result-erasure"],
  "records":{
