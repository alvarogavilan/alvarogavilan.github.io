{
  "version":"1.0",
  "name":"Loterias AI Permanent Scientific Memory",
  "status":"ACTIVE_SPEC",
  "mission":"Registrar de forma permanente, consultable y deduplicable todo experimento, fórmula, hipótesis, resultado, negativo, genealogía y evidencia para impedir repetir trabajo y permitir reutilización científica futura.",
  "principles":["append-only-evidence","content-addressed-identities","semantic-deduplication","negative-results-first-class","full-genealogy","reproducible-runs","queryable-indexes","oos-immutability","no-result-erasure"],
  "records":{
    "formula":{"required":["formulaId","canonicalExpression","semanticSignature","sha256","operators","features","parameters","genealogy","createdBy","createdAt"]},
    "experiment":{"required":["experimentId","formulaIds","gameId","datasetFingerprint","selectionWindow","oosWindow","postFreezeWindow","seed","codeCommit","workflowRun","metrics","decision","failureReasons","createdAt"]},
    "hypothesis":{"required":["hypothesisId","statement","origin","noveltySignature","relatedFormulaIds","status","falsificationPlan"]},
    "negative":{"required":["negativeId","semanticSignature","gameId","reason","evidenceRefs","scope","createdAt"]},
    "claim":{"required":["claimId","type","evidenceRefs","auditStatus","replicationStatus"]}
  },
  "indexes":["sha256","semanticSignature","gameId","formulaFamily","featureSet","operatorSet","genealogy","experimentDecision","failureReason","datasetFingerprint","codeCommit","workflowRun","date"],
  "duplicateGate":{"beforeCompute":true,"checks":["exact-sha256","canonical-expression","semantic-signature","genealogy-equivalence","negative-memory","dataset+formula+parameters+seed"],"onDuplicate":"REUSE_EXISTING_EVIDENCE","onKnownNegative":"SKIP_UNLESS_NEW_FALSIFICATION_REASON"},
  "retention":{"policy":"PERMANENT","deleteScientificEvidence":false,"compactByReference":true,"storeLargeArtifactsByContentHash":true,"preserveRawMetrics":true},
  "queryContract":{"audiences":["research-orchestrator","scientists","auditors","app","book","human-review"],"queries":["has-this-been-tested","show-formula-history","show-all-negatives","show-genealogy","show-oos-evidence","show-replications","find-nearest-semantic-method","explain-why-skipped"]},
  "safety":{"realMoneyPass":false,"realStakeEUR":0,"oosRetuningForbidden":true,"negativePersistenceRequired":true}
}
