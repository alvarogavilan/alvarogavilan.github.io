    "behavior":{"required":["behaviorHash","gameId","predictionWindow","predictionTrajectoryHash","representativeFormulaId","cloneFormulaIds","datasetFingerprint","createdAt"]},
    "experiment":{"required":["experimentId","formulaIds","behaviorHashes","gameId","datasetFingerprint","selectionWindow","oosWindow","postFreezeWindow","seed","codeCommit","workflowRun","metrics","decision","failureReasons","createdAt"]},
    "hypothesis":{"required":["hypothesisId","statement","origin","noveltySignature","relatedFormulaIds","status","falsificationPlan"]},
    "negative":{"required":["negativeId","semanticSignature","behaviorHash","gameId","reason","evidenceRefs","scope","createdAt"]},
    "claim":{"required":["claimId","type","evidenceRefs","auditStatus","replicationStatus","independentBehaviorCount"]}
  },
  "indexes":["sha256","semanticSignature","behaviorHash","predictionTrajectoryHash","gameId","formulaFamily","featureSet","operatorSet","genealogy","experimentDecision","failureReason","datasetFingerprint","codeCommit","workflowRun","date"],
  "duplicateGate":{"beforeCompute":true,"beforePromotion":true,"checks":["exact-sha256","canonical-expression","semantic-signature","genealogy-equivalence","prediction-trajectory-hash","negative-memory","dataset+formula+parameters+seed"],"onSemanticDuplicate":"REUSE_EXISTING_EVIDENCE","onBehavioralDuplicate":"COLLAPSE_TO_ONE_REPRESENTATIVE","onKnownNegative":"SKIP_UNLESS_NEW_FALSIFICATION_REASON"},
  "signalAccounting":{"behavioralClonesCountAsOne":true,"repeat5PlusRequiresIndependentBehaviorAudit":true,"fullMainRequiresIndependentBehaviorAudit":true},
  "retention":{"policy":"PERMANENT","deleteScientificEvidence":false,"compactByReference":true,"storeLargeArtifactsByContentHash":true,"preserveRawMetrics":true,"preservePredictionTrajectories":true},
  "queryContract":{"audiences":["research-orchestrator","scientists","auditors","app","book","human-review"],"queries":["has-this-been-tested","has-this-behavior-been-produced","show-formula-history","show-behavioral-clones","show-all-negatives","show-genealogy","show-oos-evidence","show-replications","find-nearest-semantic-method","find-nearest-behavior","explain-why-skipped"]},
  "safety":{"realMoneyPass":false,"realStakeEUR":0,"oosRetuningForbidden":true,"negativePersistenceRequired":true}
