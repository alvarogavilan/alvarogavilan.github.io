  "analysisPlan": {
    "discovery": ["number-by-extraction-position association","inter-extraction-time association","velocity-regime association","machine-regime association","sequence transition association"],
    "controls": ["within-draw permutation","date-matched permutation","machine-regime matched randomization"],
