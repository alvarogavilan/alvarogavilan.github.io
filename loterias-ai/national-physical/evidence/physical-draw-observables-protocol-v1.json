    {"id":"primitiva","specialist":"physical-primitiva-v1","drawDays":"Mon/Thu/Sat","ballCount":6},
    {"id":"gordo-primitiva","specialist":"physical-gordo-v1","drawDays":"Sun","ballCount":5},
    {"id":"loteria-nacional","specialist":"physical-nacional-v1","drawDays":"Thu/Sat","ballCount":null},
