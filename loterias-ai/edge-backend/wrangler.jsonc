{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loterias-edge-sentinel",
  "main": "src/index-v7.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "EDGE_SENTINEL",
        "class_name": "EdgeSentinel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EdgeSentinel"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
